#!/bin/bash
#options for sbatch
#SBATCH --account=PR_carisma
#SBATCH --job-name=hazard # Job name
#SBATCH --time=0-24:00 # time limit (D-HH:MM)
#SBATCH --nodes=1 # number of nodes
#SBATCH --partition=cpuq
#SBATCH --nodelist=cn05
#SBATCH --array=1-1 # number of jobs to run
#SBATCH --ntasks=1                    # Number of tasks per job (single-core task)
#SBATCH --cpus-per-task=10            # Number of threads per task
#SBATCH --output ./log/run-%j.txt       # Standard out goes to this file
#SBATCH --error ./log/error-%j.txt      # Standard err goes to this file

# for calculating the amount of time the job takes
begin=`date +%s`
echo node: $HOSTNAME
echo start time: `date`
echo ...........

# setting up variables if provided
region=$1
size=$2
mode=$3
masksize=$4
split=$5
#TODO: add channels, zdim, and other hyper parameters  like batch size, learning rate, epoch of pretrian etc

# echo 'Running on' $region 'with' $size 'events' $mode 'mode' $masksize 'masksize'

# loading modules or conda
source /home/${USER}/.bash_profile # loading bash_proi
conda activate /mnt/beegfs/nragu/tsunami/env # conda environment

# # Define input and output directories
# INPUT_DIR="/mnt/beegfs/nragu/tsunami/ML4SicilyTsunami/risk/hazard"
# OUTPUT_DIR="/mnt/beegfs/nragu/tsunami/ML4SicilyTsunami/data/2upload/hazard"
# FILE_LIST=($(ls $INPUT_DIR/*.npy))  #all .npy files in the input directory 
# cd $INPUT_DIR

# # Compress each file in the list
# for file in ${FILE_LIST[@]}; do
#     gzip -v --fast -c "$file" > "$OUTPUT_DIR/$(basename $file).gz"
# done

# Define input and output directories
INPUT_DIR="/mnt/beegfs/nragu/tsunami/ML4SicilyTsunami/risk/loss"
OUTPUT_DIR="/mnt/beegfs/nragu/tsunami/ML4SicilyTsunami/data/2upload/loss"
FILE_LIST=($(ls $INPUT_DIR/*.hdf5))  #all .npy files in the input directory 
cd $INPUT_DIR

# Compress each file in the list
for file in ${FILE_LIST[@]}; do
    gzip -v --fast -c "$file" > "$OUTPUT_DIR/$(basename $file).gz"
done


# finished commands
echo ...........
end=`date +%s`
elapsed=`expr $end - $begin`
echo Time taken: $elapsed seconds